# Copy this file to .env.local for development, and set the same keys in
# Hostinger's environment variable settings for production. Never commit a
# file containing real values — only .env.example (names only) is tracked.

# Supabase — public (safe to expose to the browser; NEXT_PUBLIC_* is inlined
# into client bundles at build time).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — SECRET. Server-only, bypasses Row Level Security entirely.
# Never prefix a secret with NEXT_PUBLIC_, never import this into a Client
# Component.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection — SECRET. Used only by local migration/seed
# scripts (scripts/run-migrations.mjs, scripts/seed-cms.mjs), never imported
# by the Next.js app itself. Not required at runtime in production.
SUPABASE_DB_PASSWORD=
DATABASE_URL=

# Public production site URL — every canonical URL, Open Graph url, hreflang
# alternate, sitemap entry, and JSON-LD url falls back to a hardcoded default
# (src/lib/seo/site.ts) if this is unset, but production should set it
# explicitly to the real deployed domain (with https://, no trailing slash).
NEXT_PUBLIC_SITE_URL=
